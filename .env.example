# TikTok Developer App credentials - copiar a .env (nunca commitear .env)
# Obtenidas al registrar la app en developers.tiktok.com (Iteración 1)

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Tokens obtenidos vía OAuth 2.0 (se completan en runtime, no a mano)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Cuenta de prueba usada para las pruebas E2E (modo sandbox/privado, nunca público)
TIKTOK_TEST_ACCOUNT_NOTE="Cuenta de desarrollador propia - Content Posting API SIEMPRE en privacy_level=SELF_ONLY/draft, nunca público"
